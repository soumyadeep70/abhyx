# ---- Server ----
NODE_ENV=development
PORT=8080
API_BASE_PATH=/api/v1

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ---- Database (password must match postgres/.env) ----
DATABASE_URL=postgresql://admin:__PG_PASSWORD__@postgres:5432/abhyx
DATABASE_SSL=false
DB_POOL_MAX=10

# ---- Authentication ----
# Must be the URL the browser uses to reach the backend (not the container hostname)
BETTER_AUTH_URL=http://localhost:8080/api/v1/auth
BETTER_AUTH_SECRET=__AUTH_SECRET__
SESSION_EXPIRES_IN_DAYS=30
SESSION_UPDATE_AGE_HOURS=24
BCRYPT_SALT_ROUNDS=11

# ---- AI service (must match ai-service/.env) ----
AI_SERVICE_BASE_URL=http://ai-service:9000
AI_SERVICE_API_KEY=__AI_KEY__
AI_SERVICE_TIMEOUT_MS=20000

# ---- Judge0 (self-hosted: no key/host; set both only for RapidAPI) ----
JUDGE0_BASE_URL=http://judge0-server:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_POLL_MAX_ATTEMPTS=15

# ---- Cache and cron ----
READINESS_CACHE_TTL_MINUTES=60
WEAK_TOPIC_CACHE_TTL_HOURS=24
ROADMAP_CACHE_TTL_HOURS=24
COMPANY_INTEL_CACHE_TTL_HOURS=24
NIGHTLY_JOB_CRON=0 2 * * *
ENABLE_CRON=true

# ---- Uploads ----
MAX_RESUME_UPLOAD_MB=5