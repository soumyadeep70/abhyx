# ---- Server ----
NODE_ENV=development
PORT=8080
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (Postgres / Neon) ----
DATABASE_URL=postgres://placement_user:placement_pass@localhost:5432/placement_platform
DATABASE_SSL=false
DB_POOL_MAX=10

# ---- Auth (better-auth) ----
# 32+ random chars. `openssl rand -base64 32` is a good way to generate one.
BETTER_AUTH_SECRET=change-me-better-auth-secret-min-32-chars-long
# Must match the URL clients actually reach this API on.
BETTER_AUTH_URL=http://localhost:8080
SESSION_EXPIRES_IN_DAYS=30
SESSION_UPDATE_AGE_HOURS=24
BCRYPT_SALT_ROUNDS=11

# ---- AI microservice (FastAPI) ----
AI_SERVICE_BASE_URL=http://localhost:9000
AI_SERVICE_TIMEOUT_MS=20000
AI_SERVICE_API_KEY=change-me-shared-secret

# ---- Judge0 ----
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_POLL_MAX_ATTEMPTS=15

# ---- Cache / cron ----
READINESS_CACHE_TTL_MINUTES=60
WEAK_TOPIC_CACHE_TTL_HOURS=24
ROADMAP_CACHE_TTL_HOURS=24
COMPANY_INTEL_CACHE_TTL_HOURS=24
NIGHTLY_JOB_CRON=0 2 * * *
ENABLE_CRON=true

# ---- File uploads ----
MAX_RESUME_UPLOAD_MB=5
